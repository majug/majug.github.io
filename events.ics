---
layout: null
---

BEGIN:VCALENDAR
PRODID:http://majug.de/
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:majug
X-WR-TIMEZONE:Europe/Berlin
X-WR-CALDESC:Kommende Termine der Mannheimer Java User Group
BEGIN:VTIMEZONE
TZID:Europe/Berlin
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
{% assign event_count = 0 %}{% for post in site.posts %}{% unless post.calendar == false %}{% if event_count < 10 %}{% assign event_count = event_count | plus: 1 %}{% assign event_date = post.event_date | default: post.date %}{% assign event_start_time = post.start_time | default: "190000" %}{% assign event_end_time = post.end_time | default: "203000" %}{% capture summary %}{{ post.title }}{% if post.speaker %} ({{ post.speaker }}){% endif %}{% endcapture %}BEGIN:VEVENT
DTSTART;TZID=Europe/Berlin:{{ event_date | date: "%Y%m%d" }}T{{ event_start_time }}
DTEND;TZID=Europe/Berlin:{{ event_date | date: "%Y%m%d" }}T{{ event_end_time }}
DTSTAMP:{{ site.time | date: "%Y%m%dT%H%M%SZ" }}
UID:{{ event_date | date: "%Y%m%d" }}-{{ post.slug }}@majug.de
ORGANIZER;CN="majug² Java User Group Mannheim":MAILTO:info@majug.de
{% if post.location %}LOCATION:{{ post.location }}
{% endif %}SUMMARY:{{ summary | strip }}
DESCRIPTION:{{ site.url }}{{ post.url }}
URL:{{ site.url }}{{ post.url }}
END:VEVENT
{% endif %}{% endunless %}{% endfor %}END:VCALENDAR
